# --- Shared with the Next.js app ---------------------------------------------
# Same value as MEDIA_CONTROL_SECRET in the app's .env (Bearer auth, both directions)
MEDIA_CONTROL_SECRET=change-me-long-random
# Where callbacks go: ${APP_URL}/api/media/callback. Use host.docker.internal for a dev server on the host.
APP_URL=http://host.docker.internal:3000
# Browser origin of the app, used for CORS on the origin server
APP_ORIGIN=http://localhost:3000

# --- Output / CDN -----------------------------------------------------------------
# Public base URL of the nginx origin (or the CDN in front of it); manifestUrl = ${CDN_BASE_URL}/<eventId>/manifest.mpd
CDN_BASE_URL=http://localhost:8081
# Host folder for segments (output/) and FIFOs (work/)
MEDIA_DATA_DIR=./data
SEGMENT_SECONDS=2
# auto = passthrough when H.264 (+AAC), transcode to 1080p H.264 only otherwise; always | never
TRANSCODE=auto

# --- Ingest -----------------------------------------------------------------------
# Hostname given to the rights holder in ingestUrl
INGEST_PUBLIC_HOST=localhost
SRT_PUBLIC_PORT=8890
RTMP_PUBLIC_PORT=1935
CONTROL_PORT=8080
ORIGIN_PORT=8081
# MediaMTX -> control auth hook token, and the internal RTSP read-back credentials
MEDIAMTX_HOOK_TOKEN=change-me-hook-token
MEDIAMTX_READ_USER=packager
MEDIAMTX_READ_PASS=change-me-read-pass

# --- DRM keys (PallyCon KMS, CPIX) ------------------------------------------------
PALLYCON_KMS_URL=https://kms.pallycon.com/v2/cpix/pallycon/getKey
PALLYCON_KMS_TOKEN=
# Local testing without PallyCon only (32 hex chars each); ignored when PALLYCON_KMS_TOKEN is set
DRM_DEV_KEY_ID=
DRM_DEV_KEY=

# --- Pull inputs (HLS / DASH / RTSP / BROWSER) ------------------------------------------
# inputUrl hosts that resolve to private/loopback/link-local addresses are rejected (SSRF guard).
# true = allow them. Local testing only, never in production.
ALLOW_PRIVATE_INPUT_HOSTS=false

# --- BROWSER input (Chromium page capture, the "capture" container) ------------------------
# Enable the capture container and BROWSER inputs: set both. Leave empty to disable BROWSER.
COMPOSE_PROFILES=
# e.g. COMPOSE_PROFILES=browser
# control -> capture bearer token (openssl rand -hex 32)
CAPTURE_TOKEN=
# Concurrent BROWSER events; each needs ~3-4 dedicated cores (1080p30 x264 + Chromium rendering)
CAPTURE_MAX_SESSIONS=1
CAPTURE_CPUS=4
CAPTURE_MEM_LIMIT=3g
# x264 settings for the capture (CRF capped at MAXRATE, keyframe every SEGMENT_SECONDS)
CAPTURE_X264_PRESET=veryfast
CAPTURE_CRF=18
CAPTURE_MAXRATE=8M
CAPTURE_BUFSIZE=16M
# Warn the app (live.error) when the first N seconds are black, typically a DRM player. 0 = off
BROWSER_BLACK_CHECK_SECONDS=30
