# App
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/termtee

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Payment: bank transfer + slip upload
# The PROMPTPAY_ID / PAYMENT_* values below are only defaults: once the payment tab in
# /admin/settings is saved, those settings win.
# PromptPay ID for the payment QR (phone 10 digits / citizen or tax ID 13 digits / e-wallet 15 digits)
PROMPTPAY_ID=
# Shown on the payment page
PAYMENT_DISPLAY_NAME=
PAYMENT_DISPLAY_BANK=
# Comma-separated receiving account numbers / PromptPay IDs a slip may be paid to
PAYMENT_ACCOUNTS=
# Comma-separated accepted receiver names as printed on slips (Thai and/or English)
PAYMENT_NAMES=
# Optional bank-confirming slip verifier: none (local QR + OCR checks only), or one or more of
# slip2go | thunder | easyslip, comma-separated in failover order (e.g. slip2go,thunder)
SLIP_PROVIDER=none
# Slip2Go: API URL from the dashboard (app.slip2go.com), secret key as Bearer token
SLIP2GO_API_URL=
SLIP2GO_SECRET_KEY=
SLIP2GO_TIMEOUT_MS=15000
# Thunder Solution (api.thunder.in.th v2)
THUNDER_API_KEY=
THUNDER_TIMEOUT_MS=15000
EASYSLIP_API_KEY=
EASYSLIP_TIMEOUT_MS=15000
# Private slip image storage (must be outside public/)
SLIP_STORAGE_DIR=./storage/slips
# Cache dir for OCR language data (tesseract traineddata); empty = OS temp dir
SLIP_OCR_CACHE_DIR=
# Offline servers: local folder containing tha/eng.traineddata.gz
SLIP_OCR_LANG_PATH=
SLIP_OCR_TIMEOUT_MS=20000

# DRM (PallyCon)
PALLYCON_SITE_ID=
PALLYCON_SITE_KEY=
PALLYCON_ACCESS_KEY=

# Media server control (shared secret, both directions)
MEDIA_CONTROL_URL=http://localhost:8080
MEDIA_CONTROL_SECRET=

# Cron (expire replays)
CRON_SECRET=

# Email notifications (SMTP). Empty SMTP_URL = emails disabled (logged as SKIPPED)
SMTP_URL=
EMAIL_FROM=TERMTEE <no-reply@example.com>

# Support case attachments (private, outside public/)
UPLOAD_STORAGE_DIR=./storage/uploads

# Cron jobs (call with Authorization: Bearer $CRON_SECRET):
#   /api/cron/reminders       every 5 min   (event starting / replay expiring emails)
#   /api/cron/expire-replays  every 10 min  (archive expired replays, cancel unpaid orders)
